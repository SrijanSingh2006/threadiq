# ============================================================
# ThreadIQ Platform Environment Configuration
# ============================================================

# Database Configuration
# SQLite local development fallback (default):
DATABASE_URL=sqlite:///./threadiq.db
# PostgreSQL production configuration:
# DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/threadiq

# Google Gemini Generative AI Configuration
# Leave empty to utilize the built-in deterministic intelligence engine fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-pro

# Security & Authentication
SECRET_KEY=threadiq-enterprise-pm-portfolio-secret-key-32bytes-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Seed Data Configuration
SEED_CUSTOMERS=5000
SEED_EVENTS=20000
SEED_ORDERS=2000
